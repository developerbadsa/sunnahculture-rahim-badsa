{% doc %}
  @prompt
    Create a collection product grid where each product card shows a small image slider with left and right arrow buttons, letting shoppers browse through that product's additional photos without leaving the collection page. The arrows should be subtle, appear over the image, and work on both desktop and mobile with swipe support. Clicking the image itself should still open the product page.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-grid-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    color: #101010;
  }

  .ai-product-grid-{{ ai_gen_id }}__items {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, minmax(0, 1fr));
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-product-grid-{{ ai_gen_id }}__card {
    min-width: 0;
  }

  .ai-product-grid-{{ ai_gen_id }}__media {
    position: relative;
    overflow: hidden;
    background: #f5f5f5;
    aspect-ratio: {{ block.settings.image_ratio }};
    touch-action: pan-y;
  }

  .ai-product-grid-{{ ai_gen_id }}__track {
    display: flex;
    height: 100%;
    transition: transform 240ms ease;
    will-change: transform;
  }

  .ai-product-grid-{{ ai_gen_id }}__slide {
    flex: 0 0 100%;
    min-width: 100%;
    height: 100%;
  }

  .ai-product-grid-{{ ai_gen_id }}__slide img,
  .ai-product-grid-{{ ai_gen_id }}__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-product-grid-{{ ai_gen_id }}__placeholder svg {
    width: 100%;
    height: 100%;
  }

  .ai-product-grid-{{ ai_gen_id }}__arrow {
    position: absolute;
    top: 50%;
    z-index: 2;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, .85);
    border-radius: 50%;
    background: rgba(16, 16, 16, .58);
    color: #fff;
    cursor: pointer;
    opacity: .82;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-product-grid-{{ ai_gen_id }}__arrow:hover,
  .ai-product-grid-{{ ai_gen_id }}__arrow:focus-visible {
    opacity: 1;
  }

  .ai-product-grid-{{ ai_gen_id }}__arrow--prev { left: 10px; }
  .ai-product-grid-{{ ai_gen_id }}__arrow--next { right: 10px; }
  .ai-product-grid-{{ ai_gen_id }}__arrow svg { width: 16px; height: 16px; }

  .ai-product-grid-{{ ai_gen_id }}__dots {
    position: absolute;
    bottom: 10px;
    left: 50%;
    display: flex;
    gap: 5px;
    transform: translateX(-50%);
  }

  .ai-product-grid-{{ ai_gen_id }}__dot {
    width: 6px;
    height: 6px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, .7);
  }

  .ai-product-grid-{{ ai_gen_id }}__dot.is-active { background: #101010; box-shadow: 0 0 0 1px #fff; }

  .ai-product-grid-{{ ai_gen_id }}__info { padding-top: 12px; }
  .ai-product-grid-{{ ai_gen_id }}__title { margin: 0 0 5px; font-size: 15px; line-height: 1.3; }
  .ai-product-grid-{{ ai_gen_id }}__title a { color: inherit; text-decoration: none; }
  .ai-product-grid-{{ ai_gen_id }}__price { font-size: 14px; }

  @media screen and (max-width: 749px) {
    .ai-product-grid-{{ ai_gen_id }}__items { grid-template-columns: repeat({{ block.settings.columns_mobile }}, minmax(0, 1fr)); gap: {{ block.settings.mobile_gap }}px; }
    .ai-product-grid-{{ ai_gen_id }}__arrow { width: 30px; height: 30px; }
  }
{% endstyle %}

<product-slider-grid-{{ ai_gen_id }} class="ai-product-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-product-grid-{{ ai_gen_id }}__items">
    {% if block.settings.collection != blank %}
      {% for product in block.settings.collection.products limit: block.settings.product_limit %}
        <article class="ai-product-grid-{{ ai_gen_id }}__card">
          <div class="ai-product-grid-{{ ai_gen_id }}__media" data-slider>
            <a href="{{ product.url }}" aria-label="View {{ product.title | escape }}">
              <div class="ai-product-grid-{{ ai_gen_id }}__track">
                {% for image in product.images limit: 6 %}
                  <div class="ai-product-grid-{{ ai_gen_id }}__slide">
                    <img src="{{ image | image_url: width: 900 }}" alt="{{ image.alt | default: product.title | escape }}" loading="lazy" width="{{ image.width }}" height="{{ image.height }}">
                  </div>
                {% endfor %}
                {% if product.images.size == 0 %}
                  <div class="ai-product-grid-{{ ai_gen_id }}__slide"><div class="ai-product-grid-{{ ai_gen_id }}__placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}</div></div>
                {% endif %}
              </div>
            </a>
            {% if product.images.size > 1 %}
              <button type="button" class="ai-product-grid-{{ ai_gen_id }}__arrow ai-product-grid-{{ ai_gen_id }}__arrow--prev" data-direction="prev" aria-label="Previous image for {{ product.title | escape }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg></button>
              <button type="button" class="ai-product-grid-{{ ai_gen_id }}__arrow ai-product-grid-{{ ai_gen_id }}__arrow--next" data-direction="next" aria-label="Next image for {{ product.title | escape }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg></button>
              <div class="ai-product-grid-{{ ai_gen_id }}__dots" aria-hidden="true">{% for image in product.images limit: 6 %}<span class="ai-product-grid-{{ ai_gen_id }}__dot{% if forloop.first %} is-active{% endif %}"></span>{% endfor %}</div>
            {% endif %}
          </div>
          <div class="ai-product-grid-{{ ai_gen_id }}__info"><h3 class="ai-product-grid-{{ ai_gen_id }}__title"><a href="{{ product.url }}">{{ product.title }}</a></h3><div class="ai-product-grid-{{ ai_gen_id }}__price">{{ product.price | money }}</div></div>
        </article>
      {% endfor %}
    {% else %}
      <p>Select a collection to display products.</p>
    {% endif %}
  </div>
</product-slider-grid-{{ ai_gen_id }}>

<script>
(function() {
  class ProductSliderGrid{{ ai_gen_id }} extends HTMLElement {
    connectedCallback() {
      this.querySelectorAll('[data-slider]').forEach((slider) => {
        const track = slider.querySelector('.ai-product-grid-{{ ai_gen_id }}__track');
        const slides = slider.querySelectorAll('.ai-product-grid-{{ ai_gen_id }}__slide');
        const dots = slider.querySelectorAll('.ai-product-grid-{{ ai_gen_id }}__dot');
        if (slides.length < 2) return;
        let index = 0;
        let startX = 0;
        const update = () => { track.style.transform = 'translateX(-' + (index * 100) + '%)'; dots.forEach((dot, i) => dot.classList.toggle('is-active', i === index)); };
        slider.querySelectorAll('[data-direction]').forEach((button) => button.addEventListener('click', (event) => { event.preventDefault(); event.stopPropagation(); index = button.dataset.direction === 'next' ? (index + 1) % slides.length : (index - 1 + slides.length) % slides.length; update(); }));
        slider.addEventListener('pointerdown', (event) => { startX = event.clientX; });
        slider.addEventListener('pointerup', (event) => { const distance = event.clientX - startX; if (Math.abs(distance) > 40) { index = distance < 0 ? (index + 1) % slides.length : (index - 1 + slides.length) % slides.length; update(); } });
      });
    }
  }
  if (!customElements.get('product-slider-grid-{{ ai_gen_id }}')) customElements.define('product-slider-grid-{{ ai_gen_id }}', ProductSliderGrid{{ ai_gen_id }});
})();
</script>

{% schema %}
{
  "name": "Collection product slider",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "product_limit", "label": "Products to show", "min": 4, "max": 24, "step": 1, "default": 12 },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "select", "id": "columns_desktop", "label": "Columns on desktop", "options": [{ "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }, { "value": "5", "label": "5" }], "default": "4" },
    { "type": "select", "id": "columns_mobile", "label": "Columns on mobile", "options": [{ "value": "1", "label": "1" }, { "value": "2", "label": "2" }], "default": "2" },
    { "type": "select", "id": "image_ratio", "label": "Image ratio", "options": [{ "value": "1 / 1", "label": "Square" }, { "value": "2 / 3", "label": "Portrait" }, { "value": "3 / 2", "label": "Landscape" }], "default": "2 / 3" },
    { "type": "range", "id": "grid_gap", "label": "Grid gap", "min": 8, "max": 40, "step": 4, "unit": "px", "default": 20 },
    { "type": "range", "id": "mobile_gap", "label": "Mobile gap", "min": 8, "max": 24, "step": 4, "unit": "px", "default": 12 }
  ],
  "presets": [{ "name": "Collection product slider" }],
  "tag": null,
  "class": "collection-product-slider-block"
}
{% endschema %}